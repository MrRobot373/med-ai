# GMS Clinical AI — server settings. Written by install.sh; never commit or e-mail this file.
APP_ENV=production
APP_TIMEZONE=@TIMEZONE@
SITE_ADDRESS=@SITE_ADDRESS@
TLS_ARGS=internal
HTTP_PORT=80
HTTPS_PORT=443
DATA_PATH=@DATA_PATH@
# People reach the app through the HTTPS proxy only
COOKIE_SECURE=true
CORS_ORIGINS=https://@SITE_ADDRESS@

# --- Keys (keep a copy of ALL THREE somewhere other than this server; without them data cannot be recovered) ---
APP_SECRET_KEY=@APP_SECRET_KEY@
DATA_ENCRYPTION_KEY=@DATA_ENCRYPTION_KEY@
BACKUP_ENCRYPTION_KEY=@BACKUP_ENCRYPTION_KEY@
ENCRYPTION_AT_REST_ATTESTED=@DISK_ENCRYPTED@

# --- First administrator (used once, when the database is empty; the password must be changed at first sign-in) ---
BOOTSTRAP_ADMIN_EMAIL=@ADMIN_EMAIL@
BOOTSTRAP_ADMIN_NAME=@ADMIN_NAME@
BOOTSTRAP_ADMIN_PASSWORD=@ADMIN_PASSWORD@

# --- Where the AI models run (change later in Settings → AI models) ---
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_BASE_URL=@AI_URL@
DEFAULT_LLM_MODEL=qwen3.5:9b
DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_EMBEDDING_BASE_URL=@AI_URL@
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Optional parts, comma separated:  clamav,qdrant,ollama
COMPOSE_PROFILES=
# CLAMAV_HOST=clamav
LOG_LEVEL=INFO
