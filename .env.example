# ---------------------------------------------------------------------------
# GMS Clinical AI — environment (copy to .env)
#
# Only infrastructure settings live here. AI providers, models, retrieval
# parameters and branding are configured at runtime in
# Settings (stored in the database) — the DEFAULT_* values below only seed
# that configuration on the very first start.
# ---------------------------------------------------------------------------

# development | demo | production
APP_ENV=development
# REQUIRED in production: signs sessions and encrypts stored API keys.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-in-production

# Where the database, uploads and embedded vector store live
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/gms.db

# Browser origins allowed to call the API in development (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when served over HTTPS
COOKIE_SECURE=false
UPLOAD_MAX_MB=40

# First administrator (created only when no users exist) — change the password after sign-in
BOOTSTRAP_ADMIN_EMAIL=admin@lifecaremedico.in
BOOTSTRAP_ADMIN_PASSWORD=Admin@2026
BOOTSTRAP_ADMIN_NAME=Vikram Shah

# --- First-run defaults for the runtime AI configuration -------------------
# LLM: "ollama" (native) or "openai" (any OpenAI-compatible endpoint)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=qwen3.5:9b
# Embeddings: "ollama", "openai" or "local" (needs: pip install -e ".[local-models]")
DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_EMBEDDING_BASE_URL=http://localhost:11434
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Leave empty for the embedded vector store; set to use a Qdrant server
DEFAULT_VECTOR_STORE_URL=

LOG_LEVEL=INFO

# --- Protection of data (see docs/SECURITY_OPERATIONS.md) ------------------
# Encrypts uploaded files (AES-256-GCM). Generate one:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Back this key up separately: without it encrypted files cannot be read.
DATA_ENCRYPTION_KEY=
# Set to true once the data volume itself is encrypted (LUKS / BitLocker). Shown on the security checklist.
ENCRYPTION_AT_REST_ATTESTED=false
# Virus scanning of uploads through ClamAV (docker compose --profile clamav up -d):
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=true
# Only for a closed network without HTTPS; production normally runs behind the bundled HTTPS proxy.
ALLOW_INSECURE_HTTP=false
UPLOAD_MAX_PDF_PAGES=300

# --- Backups, licence, time zone (see docs/OPERATIONS.md) -------------------
# Encrypts backups (required in production). Generate like DATA_ENCRYPTION_KEY above and keep a copy OFF this server.
BACKUP_ENCRYPTION_KEY=
# Where backups are written (default: <DATA_DIR>/backups)
# BACKUP_DIR=
# Clinic-local time zone for dates on printed documents and the daily backup time
APP_TIMEZONE=Asia/Kolkata
# Vendor public key for licence files; normally built in (backend/app/assets/licence_public.pem)
# LICENCE_PUBLIC_KEY=
