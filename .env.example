# GMS Clinical AI — environment configuration
# Copy to .env and adjust. Never commit a real .env file.

# --- Application ---
APP_ENV=demo
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-64-char-value
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (SQLite owns application state) ---
# Leave unset to use the built-in default (<repo root>/data/sqlite/gms.db, resolved
# absolutely regardless of which directory a command is run from). Only set this if you
# want the database somewhere else — use an absolute sqlite:/// path if you do, since a
# relative one is resolved against whatever directory the process happens to be run
# from (backend/ for alembic/uvicorn/pytest, repo root for scripts/*.py).
# DATABASE_URL=sqlite:////absolute/path/to/gms.db

# --- Vector DB (Qdrant owns retrieval vectors) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Local LLM / VLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# --- Embedding / Reranker (local, CPU-preferred) ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu

# --- RAG retrieval defaults (Fast Demo profile — see docs/rag-design.md) ---
RAG_PROFILE=fast_demo
RAG_DENSE_TOP_K=30
RAG_SPARSE_TOP_K=30
RAG_FUSION_TOP_K=20
RAG_RERANK_TOP_K=8
RAG_DEFAULT_CONTEXT_TOKENS=8192

# --- Research Mode (optional, off by default — privacy-first) ---
ENABLE_RESEARCH=false
SEARXNG_URL=http://localhost:8080

# --- Voice module (feature-flagged, off until Phase 11+) ---
ENABLE_VOICE=false

# --- Uploads / sessions ---
UPLOAD_MAX_MB=25
# Leave unset to use the built-in default (<repo root>/data/uploads) — outside any
# directly-served web root (spec §92); files are only reachable via the auth-gated
# GET /api/reports/{id}/file endpoint.
# UPLOAD_DIR=/absolute/path/to/uploads
SESSION_TIMEOUT_MINUTES=60

# --- Ingestion (Phase 05) ---
# OCR auto-detects (on if easyocr is installed); this only lets you force it off.
ENABLE_OCR=true
OCR_MIN_CHARS_PER_PAGE=40

# --- Auth ---
SESSION_COOKIE_NAME=gms_session
# Set true once this is served over HTTPS — never auto-detected.
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Demo account seeding (scripts/seed_demo.py) ---
# Optional. If a *_PASSWORD is left unset, the seed script generates a random one,
# prints it once, and saves it to data/sqlite/.demo_credentials.txt (gitignored) —
# real passwords are never hardcoded in source (spec §17).
SEED_ADMIN_EMAIL=admin@gms.local
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_EMAIL=doctor@gms.local
SEED_DOCTOR_PASSWORD=
SEED_VIEWER_EMAIL=viewer@gms.local
SEED_VIEWER_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
DEBUG_MODE=false
