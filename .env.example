# GMS Clinical AI — environment configuration
# Copy to .env and adjust. Never commit a real .env file.

# --- Application ---
APP_ENV=demo
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-64-char-value
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (SQLite owns application state) ---
# Leave unset to use the built-in default (<repo root>/data/sqlite/gms.db, resolved
# absolutely regardless of which directory a command is run from). Only set this if you
# want the database somewhere else — use an absolute sqlite:/// path if you do, since a
# relative one is resolved against whatever directory the process happens to be run
# from (backend/ for alembic/uvicorn/pytest, repo root for scripts/*.py).
# DATABASE_URL=sqlite:////absolute/path/to/gms.db

# --- Vector DB (Qdrant owns retrieval vectors) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Local LLM / VLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# --- Embedding / Reranker (local, CPU-preferred) ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu

# --- RAG retrieval defaults (Fast Demo profile — see docs/rag-design.md) ---
RAG_PROFILE=fast_demo
RAG_DENSE_TOP_K=30
RAG_SPARSE_TOP_K=30
RAG_FUSION_TOP_K=20
RAG_RERANK_TOP_K=8
RAG_DEFAULT_CONTEXT_TOKENS=8192

# --- Research Mode (optional, off by default — privacy-first) ---
ENABLE_RESEARCH=false
SEARXNG_URL=http://localhost:8080

# --- Voice module (feature-flagged, off until Phase 11+) ---
ENABLE_VOICE=false

# --- Uploads / sessions ---
UPLOAD_MAX_MB=25
SESSION_TIMEOUT_MINUTES=60

# --- Logging ---
LOG_LEVEL=INFO
DEBUG_MODE=false
