# ---------------------------------------------------------------------------
# GMS Clinical AI — environment (copy to .env)
#
# Only infrastructure settings live here. AI providers, models, retrieval
# parameters and branding are configured at runtime in
# Settings (stored in the database) — the DEFAULT_* values below only seed
# that configuration on the very first start.
# ---------------------------------------------------------------------------

# development | demo | production   (demo/development show demo accounts on sign-in)
APP_ENV=development
# REQUIRED in production: signs sessions and encrypts stored API keys.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-in-production

# Where the database, uploads and embedded vector store live
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/gms.db

# Browser origins allowed to call the API in development (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when served over HTTPS
COOKIE_SECURE=false
UPLOAD_MAX_MB=40

# First administrator (created only when no users exist) — change the password after sign-in
BOOTSTRAP_ADMIN_EMAIL=admin@gms.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# --- First-run defaults for the runtime AI configuration -------------------
# LLM: "ollama" (native) or "openai" (any OpenAI-compatible endpoint)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=qwen3.5:9b
# Embeddings: "ollama", "openai" or "local" (needs: pip install -e ".[local-models]")
DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_EMBEDDING_BASE_URL=http://localhost:11434
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Leave empty for the embedded vector store; set to use a Qdrant server
DEFAULT_VECTOR_STORE_URL=

LOG_LEVEL=INFO
