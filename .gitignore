# --- Python / backend ---
backend/.venv/
backend/venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# Generated by `npx playwright test` (spec §97 E2E suite) — HTML report, traces,
# screenshots from local runs. Regenerate, don't commit.
frontend/playwright-report/
frontend/test-results/

# --- Env / secrets ---
.env
.env.local
*.local.env

# --- Data (never commit local demo/runtime state) ---
data/sqlite/*.db
data/sqlite/*.db-journal
data/sqlite/.demo_credentials.txt
data/uploads/*
!data/uploads/.gitkeep
data/documents/*
!data/documents/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Generated by scripts/generate_sample_reports.py — regenerate, don't commit.
data/sample_reports/

# Large raw knowledge-base source material (user-supplied reference PDFs, hundreds of
# MB) does not belong in git. Keep it local; Phase 05/07 ingestion reads directly from
# this folder. Small structured seed data (eye_conditions.json) IS tracked — it's
# meaningful to version and tiny.
data/*.pdf

# --- Qdrant local storage volume ---
docker/qdrant/storage/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs ---
*.log
